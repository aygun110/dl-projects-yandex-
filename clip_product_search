    "from tqdm.auto import tqdm\n",
    "\n",
    "\n",
    "def move_to_device(batch, device):\n",
    "    return {\n",
    "        key: value.to(device, non_blocking=True)\n",
    "        for key, value in batch.items()\n",
    "    }\n",
    "\n",
    "\n",
    "def get_clip_score(logits_per_image):\n",
    "    \"\"\"\n",
    "    Средний логит правильных пар image_i ↔ text_i.\n",
    "    \"\"\"\n",
    "    indices = torch.arange(\n",
    "        logits_per_image.shape[0],\n",
    "        device=logits_per_image.device\n",
    "    )\n",
    "\n",
    "    return logits_per_image[indices, indices].mean()\n",
    "\n",
    "\n",
    "def train_one_epoch(\n",
    "    model,\n",
    "    loader,\n",
    "    optimizer,\n",
    "    scaler,\n",
    "    device\n",
    "):\n",
    "    model.train()\n",
    "\n",
    "    batch_losses = []\n",
    "    batch_scores = []\n",
    "\n",
    "    progress = tqdm(loader, desc=\"Training\")\n",
    "\n",
    "    for batch_number, batch in enumerate(progress, start=1):\n",
    "        batch = move_to_device(batch, device)\n",
    "\n",
    "        optimizer.zero_grad(set_to_none=True)\n",
    "\n",
    "        use_amp = device.type == \"cuda\"\n",
    "\n",
    "        with torch.autocast(\n",
    "            device_type=device.type,\n",
    "            dtype=torch.float16,\n",
    "            enabled=use_amp\n",
    "        ):\n",
    "            outputs = model(\n",
    "                **batch,\n",
    "                return_loss=True\n",
    "            )\n",
    "\n",
    "            loss = outputs.loss\n",
    "\n",
    "        if not torch.isfinite(loss):\n",
    "            print(f\"Пропущен batch {batch_number}: loss={loss.item()}\")\n",
    "            continue\n",
    "\n",
    "        scaler.scale(loss).backward()\n",
    "\n",
    "        scaler.unscale_(optimizer)\n",
    "\n",
    "        torch.nn.utils.clip_grad_norm_(\n",
    "            model.parameters(),\n",
    "            max_norm=1.0\n",
    "        )\n",
    "\n",
    "        scaler.step(optimizer)\n",
    "        scaler.update()\n",
    "\n",
    "        clip_score = get_clip_score(\n",
    "            outputs.logits_per_image.detach()\n",
    "        )\n",
    "\n",
    "        batch_losses.append(loss.item())\n",
    "        batch_scores.append(clip_score.item())\n",
    "\n",
    "        progress.set_postfix({\n",
    "            \"batch_loss\": f\"{loss.item():.4f}\",\n",
    "            \"avg_loss\": f\"{np.mean(batch_losses):.4f}\",\n",
    "            \"batch_score\": f\"{clip_score.item():.2f}\",\n",
    "            \"avg_score\": f\"{np.mean(batch_scores):.2f}\"\n",
    "        })\n",
    "\n",
    "    return {\n",
    "        \"batch_losses\": batch_losses,\n",
    "        \"batch_scores\": batch_scores,\n",
    "        \"mean_loss\": float(np.mean(batch_losses)),\n",
    "        \"mean_score\": float(np.mean(batch_scores))\n",
    "    }"
   ]
  },
