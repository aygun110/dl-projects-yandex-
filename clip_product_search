    "from pathlib import Path\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "IMAGE_DIR = Path(\"/home/ubuntu/archive/data\")\n",
    "\n",
    "\n",
    "df_clean = df.dropna(\n",
    "    subset=[\"image\", \"description\"]\n",
    ").copy()\n",
    "\n",
    "\n",
    "df_clean[\"image\"] = (\n",
    "    df_clean[\"image\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "df_clean[\"description\"] = (\n",
    "    df_clean[\"description\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "df_clean = df_clean[\n",
    "    (df_clean[\"image\"] != \"\") &\n",
    "    (df_clean[\"description\"] != \"\")\n",
    "].copy()\n",
    "\n",
    "\n",
    "df_clean[\"image_path\"] = df_clean[\"image\"].apply(\n",
    "    lambda filename: IMAGE_DIR / filename\n",
    ")\n",
    "\n",
    "\n",
    "df_clean[\"image_exists\"] = df_clean[\"image_path\"].apply(\n",
    "    lambda path: path.is_file()\n",
    ")\n",
    "\n",
    "print(\"До удаления отсутствующих файлов:\", len(df_clean))\n",
    "print(\"Найдено изображений:\", df_clean[\"image_exists\"].sum())\n",
    "print(\"Не найдено:\", (~df_clean[\"image_exists\"]).sum())\n",
    "\n",
    "\n",
    "df_clean = df_clean[\n",
    "    df_clean[\"image_exists\"]\n",
    "].copy()\n",
    "\n",
    "\n",
    "df_clean = df_clean.drop_duplicates(\n",
    "    subset=[\"image\"],\n",
    "    keep=\"first\"\n",
    ").reset_index(drop=True)\n",
    "\n",
    "\n",
    "train_df, test_df = train_test_split(\n",
    "    df_clean,\n",
    "    test_size=0.10,\n",
    "    random_state=42,\n",
    "    shuffle=True\n",
    ")\n",
    "\n",
    "train_df = train_df.reset_index(drop=True)\n",
    "test_df = test_df.reset_index(drop=True)\n",
    "\n",
    "print(\"После очистки:\", len(df_clean))\n",
    "print(\"Train:\", len(train_df))\n",
    "print(\"Test:\", len(test_df))"
   ]
