    "\n",
    "        plt.subplot(\n",
    "            rows,\n",
    "            columns,\n",
    "            index + 1\n",
    "        )\n",
    "\n",
    "        if image_path.is_file():\n",
    "            with Image.open(image_path) as image:\n",
