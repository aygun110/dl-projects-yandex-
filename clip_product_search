     ]
    }
   ],
   "source": [
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "SEARCH_INDEX_DIR = Path(\n",
    "    \"/home/ubuntu/clip_project/search_index\"\n",
    ")\n",
    "\n",
    "EMBEDDINGS_PATH = (\n",
    "    SEARCH_INDEX_DIR / \"image_embeddings.npy\"\n",
    ")\n",
    "\n",
    "METADATA_PATH = (\n",
    "    SEARCH_INDEX_DIR / \"products.csv\"\n",
    ")\n",
    "\n",
    "image_embeddings = np.load(\n",
    "    EMBEDDINGS_PATH,\n",
    "    mmap_mode=\"r\"\n",
    ")\n",
    "\n",
    "products_df = pd.read_csv(\n",
    "    METADATA_PATH\n",
    ")\n",
    "\n",
    "print(\"Эмбеддинги:\", image_embeddings.shape)\n",
    "print(\"Товаров:\", len(products_df))\n",
    "\n",
    "assert len(image_embeddings) == len(products_df)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1bacf144",
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import torch.nn.functional as F\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "def search_products(\n",
    "    model,\n",
    "    processor,\n",
    "    products,\n",
    "    image_embeddings,\n",
    "    query,\n",
    "    top_k=5,\n",
    "    device=None\n",
    "):\n",
    "    \"\"\"\n",
    "    Ищет товары, наиболее похожие на текстовый запрос.\n",
    "\n",
    "    Параметры\n",
    "    ----------\n",
    "    model:\n",
    "        Дообученная модель CLIP.\n",
    "\n",
    "    processor:\n",
    "        CLIPProcessor, загруженный вместе с checkpoint.\n",
    "\n",
    "    products:\n",
    "        DataFrame с метаданными товаров.\n",
    "        Порядок строк должен соответствовать image_embeddings.\n",
    "\n",
    "    image_embeddings:\n",
    "        Заранее рассчитанные нормализованные эмбеддинги изображений.\n",
    "\n",
    "    query:\n",
    "        Текстовый запрос пользователя.\n",
    "\n",
    "    top_k:\n",
    "        Количество возвращаемых товаров.\n",
    "\n",
    "    device:\n",
    "        Устройство вычислений: cuda или cpu.\n",
    "\n",
    "    Возвращает\n",
    "    ----------\n",
    "    DataFrame с наиболее релевантными товарами и similarity score.\n",
    "    \"\"\"\n",
    "\n",
    "    if not isinstance(query, str) or not query.strip():\n",
    "        raise ValueError(\"Текстовый запрос не должен быть пустым\")\n",
    "\n",
    "    if len(products) != len(image_embeddings):\n",
    "        raise ValueError(\n",
    "            \"Количество товаров не совпадает \"\n",
    "            \"с количеством эмбеддингов\"\n",
    "        )\n",
    "\n",
    "    if device is None:\n",
    "        device = next(model.parameters()).device\n",
    "\n",
    "    top_k = min(\n",
    "        max(int(top_k), 1),\n",
    "        len(products)\n",
    "    )\n",
    "\n",
    "    model.eval()\n",
    "\n",
    "    text_inputs = processor(\n",
    "        text=[query.strip()],\n",
    "        padding=True,\n",
    "        truncation=True,\n",
    "        return_tensors=\"pt\"\n",
    "    )\n",
    "\n",
    "    text_inputs = {\n",
    "        key: value.to(device)\n",
    "        for key, value in text_inputs.items()\n",
    "    }\n",
    "\n",
    "    with torch.inference_mode():\n",
    "        text_outputs = model.text_model(\n",
    "            input_ids=text_inputs[\"input_ids\"],\n",
    "            attention_mask=text_inputs.get(\"attention_mask\"),\n",
    "            return_dict=True\n",
    "        )\n",
    "\n",
    "        text_features = model.text_projection(\n",
    "            text_outputs.pooler_output\n",
    "        )\n",
    "\n",
    "        text_features = F.normalize(\n",
    "            text_features.float(),\n",
    "            p=2,\n",
    "            dim=1\n",
    "        )\n",
    "\n",
    "    text_embedding = (\n",
    "        text_features\n",
    "        .squeeze(0)\n",
    "        .cpu()\n",
    "        .numpy()\n",
    "    )\n",
    "\n",
    "    similarities = (\n",
    "        image_embeddings @ text_embedding\n",
    "    )\n",
    "\n",
    "    top_indices = np.argsort(\n",
    "        similarities\n",
    "    )[::-1][:top_k]\n",
    "\n",
    "    results = products.iloc[\n",
    "        top_indices\n",
    "    ].copy()\n",
    "\n",
    "    results.insert(\n",
    "        0,\n",
    "        \"rank\",\n",
    "        range(1, len(results) + 1)\n",
    "    )\n",
    "\n",
    "    results[\"similarity\"] = similarities[\n",
    "        top_indices\n",
    "    ]\n",
    "\n",
    "    results[\"query\"] = query\n",
    "\n",
    "    return results.reset_index(drop=True)"
   ]
  },
