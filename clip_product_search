   "source": [
    "class ImageCollator:\n",
    "    def __init__(self, processor):\n",
    "        self.processor = processor\n",
    "\n",
    "    def __call__(self, batch):\n",
    "        images = [\n",
    "            item[\"image\"]\n",
    "            for item in batch\n",
    "        ]\n",
    "\n",
    "        indices = torch.tensor(\n",
    "            [item[\"index\"] for item in batch],\n",
    "            dtype=torch.long\n",
    "        )\n",
    "\n",
    "        inputs = self.processor(\n",
    "            images=images,\n",
    "            return_tensors=\"pt\"\n",
    "        )\n",
    "\n",
    "        return {\n",
    "            \"indices\": indices,\n",
    "            \"pixel_values\": inputs[\"pixel_values\"]\n",
    "        }\n",
    "\n",
    "\n",
    "image_dataset = ImageEmbeddingDataset(all_df)\n",
    "\n",
    "image_loader = DataLoader(\n",
    "    image_dataset,\n",
    "    batch_size=64,\n",
    "    shuffle=False,\n",
    "    num_workers=0,\n",
    "    pin_memory=(device.type == \"cuda\"),\n",
    "    collate_fn=ImageCollator(processor)\n",
    ")\n",
