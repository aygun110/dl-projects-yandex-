  {
   "cell_type": "markdown",
   "id": "00afc765",
   "metadata": {},
   "source": [
    "\n",
    "2.Функция поиска товаров"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c049eb35",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
