    "\n",
    "        vision_outputs = model.vision_model(\n",
    "            pixel_values=pixel_values,\n",
    "            return_dict=True\n",
    "        )\n",
    "\n",
    "        image_features = model.visual_projection(\n",
    "            vision_outputs.pooler_output\n",
    "        )\n",
    "\n",
    "        image_features = F.normalize(\n",
    "            image_features.float(),\n",
    "            p=2,\n",
    "            dim=1\n",
    "        )\n",
    "\n",
    "        embedding_batches.append(\n",
    "            image_features.cpu().numpy()\n",
    "        )\n",
    "\n",
    "        index_batches.append(\n",
    "            batch[\"indices\"].cpu().numpy()\n",
    "        )\n",
    "\n",
    "image_embeddings = np.concatenate(\n",
    "    embedding_batches,\n",
    "    axis=0\n",
    ")\n",
    "\n",
    "image_indices = np.concatenate(\n",
    "    index_batches,\n",
    "    axis=0\n",
    ")\n",
    "\n",
    "order = np.argsort(image_indices)\n",
    "\n",
    "image_embeddings = image_embeddings[order]\n",
    "image_indices = image_indices[order]\n"
   ]
